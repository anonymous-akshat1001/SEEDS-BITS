# Backend database and authentication
DATABASE_URL=postgresql+asyncpg://seeds_user:change-me@localhost:5432/seeds_db
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_DEV_USER_IMPERSONATION=false

# Bootstrap administrator used only by backend/reset_db.py
BOOTSTRAP_ADMIN_NAME=SEEDS Administrator
BOOTSTRAP_ADMIN_PHONE=9999999999
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Storage and public service URLs
AUDIO_DIR=./data/audio
BACKEND_URL=https://example.org/seeds
API_BASE_URL=https://example.org/seeds
WS_BASE_URL=wss://example.org/seeds

# Optional Firebase Cloud Messaging backend credential
FIREBASE_SERVICE_ACCOUNT_KEY=C:\secure\seeds-firebase-service-account.json

# Logging/analytics rollout: migrate first, then enable explicitly
ACTIVITY_COLLECTION_ENABLED=false
CLIENT_TELEMETRY_ENABLED=false
ANALYTICS_ENABLED=false
# Production: separately provision the least-privilege analytics login.
# ANALYTICS_DATABASE_URL=postgresql+asyncpg://analytics_reader:REPLACE@localhost/seeds_db
# Optional service-specific diagnostic directory; configure external rotation/expiry too.
# LOG_DIRECTORY=C:\seeds-logs
CORS_ORIGINS=https://your-campus-dashboard.example.org

# Select ONLY after benchmarking Foundry Local/Qwen and compatible campus runtimes.
ANALYTICS_MODEL_ENABLED=false
LOCAL_MODEL_RUNTIME=ollama
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=

# Separate, pre-provisioned local English transcription worker (optional)
TRANSCRIPTION_ENABLED=false
SPEECH_WORKER_URL=http://127.0.0.1:8001
SPEECH_WORKER_KEY=
WHISPER_MODEL_DIRECTORY=

# Independent local watchdog and optional campus SMTP
WATCHDOG_URL=http://127.0.0.1:8000
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
ALERT_SMTP_STARTTLS=true
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
